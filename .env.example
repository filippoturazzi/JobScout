# Operator configuration. Copy to .env. All variables are optional, except
# POSTGRES_PASSWORD when running with Docker.

# --- Docker (stage 6) ---
# Required by `docker compose`: the password of the bundled Postgres. Any long random
# string, e.g. the output of `openssl rand -hex 24`. The database is never published
# outside Docker's own network.
POSTGRES_PASSWORD=
# Timezone of the app. The daily digest hour (DIGEST_HOUR) is local time, and a container
# is UTC unless told otherwise.
# TZ=America/Sao_Paulo
# docker-compose.yml sets DATABASE_URL (its Postgres) and SCHEDULER_ENABLED (true, so it
# runs 24h) itself; the DATABASE_URL below is for running without Docker.

# SQLAlchemy URL. Default is a local SQLite file. Use postgresql+psycopg://... for Postgres.
DATABASE_URL=sqlite:///./jobscout.db

# Comma-separated list of enabled job sources.
SOURCES=himalayas,remotive,linkedin,indeed

# How many pages (250 jobs each) to pull from Arbeitnow per fetch. Be gentle with the free API.
ARBEITNOW_MAX_PAGES=2

# Jobs not seen in any fetch for this many days are marked inactive (used from stage 3).
INACTIVE_AFTER_DAYS=14

# --- Scraped sources via python-jobspy (stage 5) ---
# Tuning for the scraped sources (linkedin, indeed), which SOURCES above enables by default.
# A proxy is optional and usually paid. Without one, keep the volumes below low: they are
# what stops a proxy-less clone from being rate-limited or blocked.
# Comma-separated, each entry `user:pass@host:port` or a bare host.
# JOBSPY_PROXIES=user:pass@host:8080,host2:8080
# Postings fetched per search term. Every term is one scrape, so keep this small.
# JOBSPY_RESULTS_WANTED=10
# Search terms per run. Caps how many scrapes one run performs.
# JOBSPY_MAX_TERMS=3
# Only postings from the last N hours (168 is one week).
# JOBSPY_HOURS_OLD=168

# --- Scheduler (stage 3) ---
# Off by default. When on, it runs inside `jobscout serve`; the CLI stays manual.
# A search you start (`POST /search`, `jobscout search`) runs either way.
# SCHEDULER_ENABLED=true
# Ingest is cheap HTTP; matching spends LLM and embedding quota, so they have
# separate intervals.
# INGEST_INTERVAL_MINUTES=60
# MATCH_INTERVAL_MINUTES=15
# Spread firings so two jobs do not land on the same second.
# SCHEDULER_JITTER_SECONDS=30
# Run rows older than this are pruned when a new run starts.
# RUN_RETENTION_DAYS=30
# After k consecutive failures the MATCH job runs every 2**k ticks. This caps the exponent k.
# Ingest never backs off: it is cheap keyless HTTP with no quota to protect.
# Default 6 means max period is 2**6 = 64 ticks; at MATCH_INTERVAL_MINUTES=15 that is ~16 hours.
# MAX_BACKOFF_TICKS=6

# Log level (a name, not a number: DEBUG, INFO, WARNING, ERROR or CRITICAL; case-insensitive)
# for the CLI and `jobscout serve`. LOG_LEVEL=INFO is what surfaces the per-run
# similarity distribution (min/p50/max vs the threshold) that SIMILARITY_THRESHOLD is
# calibrated from. One line per run, so it stays off by default.
# LOG_LEVEL=WARNING

# Bind address for `jobscout serve`. Localhost by default, so nothing on this machine is
# reachable from the network; the page spends your LLM key, so think before changing it.
# Docker binds 0.0.0.0 inside the container only and publishes the port on 127.0.0.1.
API_HOST=127.0.0.1

# Bind port for `jobscout serve`.
API_PORT=8000

# --- Matching (stage 2b). Only `jobscout match` and GET /matches need these. ---
# JobScout uses two keys:
#   LLM_API_KEY     the chat model that reads your profile and scores each job.
#   GOOGLE_API_KEY  the embeddings that prefilter jobs by similarity (Gemini, free tier).
# If LLM_API_KEY is a Google key, it serves both and GOOGLE_API_KEY can stay empty.
#
# LLM_API_KEY: paste the key of ANY supported provider; JobScout recognises it by its prefix
# and picks a cheap default model. Rough cost per million tokens (input/output, 2026-11):
#   Groq      gsk_...      openai/gpt-oss-120b   $0.15/$0.60  (generous free tier)
#   DeepSeek  sk-<32 hex>  deepseek-flash        $0.15/$0.60  (half price off-peak)
#   Google    AIza...      gemini-3.5-flash      free tier of ~20 requests a day
#   OpenAI    sk-proj-...  gpt-5-mini
#   Anthropic sk-ant-...   claude-haiku-5-5
# Groq and DeepSeek are the cheapest way to run searches every day.
LLM_API_KEY=
# Optional. LLM_PROVIDER: google | openai | anthropic | groq | deepseek | ollama. Needed only
# when the key's shape is not recognised (e.g. an old OpenAI `sk-` key), or for ollama.
# LLM_PROVIDER=
# Optional. Overrides the provider's default model.
# LLM_MODEL=
# Embeddings provider: google (default) | openai | ollama. Chat providers such as Groq,
# DeepSeek and Anthropic have no embeddings, so Gemini's free tier does it by default.
# EMBEDDING_PROVIDER=google
# Optional. Defaults: gemini-embedding-2 (google), text-embedding-3-small (openai).
# EMBEDDING_MODEL=
# Requested embedding dimensionality; stored vectors of another size are re-embedded.
EMBEDDING_DIM=768
# Cosine floor below which a job never reaches the LLM.
# Calibrated 2026-09-25 from a live run over 30 active jobs: observed similarity was
# 0.503-0.695 (the old 0.35 floor never fired); no clean relevant/irrelevant gap was visible
# at that sample size, so raised conservatively between 0.35 and the observed floor.
SIMILARITY_THRESHOLD=0.45
# Hard cap on LLM evaluations per run (CLI `match`, each scheduled match job, and each
# search). Bounded by the provider's DAILY quota: the Gemini free tier allows 20 requests a
# day, and a search spends one more call extracting its terms. A run that hits the quota
# stops scoring and leaves the rest for the next run.
MAX_LLM_EVALUATIONS_PER_RUN=15
# How many job embeddings to compute per run; the rest are picked up by later runs.
# Bounded by the provider's per-MINUTE token budget, not by cost. The Gemini free tier
# allows ~30,000 embedding tokens/min. The vector is built from a short role-focused
# rendering (title, tags, first 600 chars), so a job costs ~175 tokens and 100 fits with
# headroom. Re-measure before raising it; a paid key can go much higher.
# MAX_EMBEDDINGS_PER_RUN=100

# Key for the Gemini embeddings (free at https://aistudio.google.com/apikey). It also
# serves as the chat key when LLM_API_KEY is empty, as in .env files written before it.
GOOGLE_API_KEY=
# Only for EMBEDDING_PROVIDER=openai with a non-OpenAI LLM_API_KEY.
# OPENAI_API_KEY=

# --- Notifications (stage 4) ---
# Leave SMTP_HOST unset to disable e-mail entirely; the digest job becomes a no-op.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=jobscout@example.com
# SMTP_PASSWORD=
# SMTP_FROM=jobscout@example.com
# SMTP_STARTTLS=true
# Local hour (this server's timezone) at or after which the daily digest goes out.
# A window missed because the process was down is still served later the same day.
# DIGEST_HOUR=9
# How often the digest job wakes to check. This is also the retry cadence after a
# failed send — there is deliberately no separate retry setting.
# DIGEST_INTERVAL_MINUTES=60
# The recipient address is NOT here: it is a per-user preference, set via PUT /preferences.
